@using ApprentissageKana.Services
@implements IDisposable

@inject GuessKanaState State

<div class="row text-center">
    <div class="col-12 align-self-center">Historique</div>
</div>

<table class="table table-hover">
    <tr class="notoSansJP text-center">
        @foreach (Tuple<String, String> histo in @State.Historique.TakeLast(7).Reverse())
        {
            <div class="@histo.Item2">
                <div class="row">
                    <span class="col-12 align-self-center">
                        @histo.Item1
                    </span>
                </div>
            </div>
        }
    </tr>
</table>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }
}
