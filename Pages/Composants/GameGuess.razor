@using ApprentissageKana.Class
@using ApprentissageKana.Services
@implements IDisposable

@inject GuessKanaState State
@inject CountTimerState TimerState

<div class="row">
    <div class="col-12 text-center bigKana @State.FontName">
        @if (State.ToGuess != null && disableButtonDemarrer)
        {
            @KanaText
        }

        @if (displayTimer && disableButtonValider)
        {
            <div>@State.CompteurDePoint / @State.CompteurTotal</div>
        }
    </div>
</div>
    
<div class="row">
    <div class="col-12 text-center @styleTimer @State.FontName">
        @if (displayTimer)
        {
            @TimerState.AfficherTemps();
        }
    </div>
</div>

<div class="row">
    <div class="col-12 input-group input-group-lg">
        <span class="input-group-text" id="inputGroup-sizing-lg">Kana</span>
        <input @onkeydown="PressKey" @bind="State.KanaToGuess" @bind:event="oninput"
               type="text" class="form-control" aria-label="Sizing example input" aria-describedby="inputGroup-sizing-lg">
    </div>
</div>

<div class="row pt-3">
    <div class="col-6">
        <div class="input-group input-group-lg">
            <span class="input-group-text" id="inputGroup-sizing-lg">Kanas trouvés</span>
            <input readonly value="@State.CompteurDePoint" type="text" class="form-control"
                   aria-label="Sizing example input" aria-describedby="inputGroup-sizing-lg">
        </div>
    </div>
    <div class="col-6">
        <div class="input-group input-group-lg">
            <span class="input-group-text" id="inputGroup-sizing-lg">Tentatives</span>
            <input readonly value="@State.CompteurTotal" type="text" class="form-control"
                   aria-label="Sizing example input" aria-describedby="inputGroup-sizing-lg">
        </div>
    </div>
</div>

<div class="row pt-3">
    <div class="col-12 col-md-6">
        <button class="btn btn-primary w-100" @onclick="StartGame" disabled="@disableButtonDemarrer">Démarrer</button>
    </div>
    <div class="col-12 col-md-6">
        <button class="btn btn-primary w-100" @onclick="State.Submit" disabled="@disableButtonValider">Valider</button>
    </div>
</div>

@code {
    private bool displayTimer = false;
    private bool disableButtonDemarrer = false;
    private bool disableButtonValider = true;
    private string styleTimer = "normalFontSize";

    private string KanaText
    {
        get
        {
            if (State.ToGuess.kanaType == KanaType.Hiragana)
                State.ToGuess.texteAAfficher = State.ToGuess.unicodeHiragana;
            else if (State.ToGuess.kanaType == KanaType.Katakana)
                State.ToGuess.texteAAfficher = State.ToGuess.unicodeKatakana;

            return State.ToGuess.texteAAfficher;
        }
    }

    protected override void OnInitialized()
    {
        State.OnChange += StateHasChanged;
        TimerState.OnChange += HandleStateChanged;
    }

    private void StartGame()
    {
        displayTimer = true;
        disableButtonDemarrer = true;
        disableButtonValider = false;
        State.CompteurDePoint = 0;
        State.CompteurTotal = 0;
        TimerState.DemarrerChrono();
        styleTimer = "normalFontSize";
    }

    private void StopGame()
    {
        disableButtonDemarrer = false;
        disableButtonValider = true;
        TimerState.ArreterChrono();
        State.ResetHistorique();
        styleTimer = "bigFontSize";
    }

    private void PressKey(KeyboardEventArgs e)
    {
        if (!disableButtonValider)
        {
            if (e.Code == "Enter" || e.Code == "NumpadEnter")
                State.Submit();

            if (State.CompteurTotal == 30 && displayTimer)
                StopGame();
        }
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
        TimerState.OnChange -= HandleStateChanged;
    }
}