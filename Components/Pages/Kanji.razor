@page "/Kanji"
@rendermode InteractiveServer

<h1>Kanji</h1>

<button class="btn btn-primary w-100" @onclick="CreateFakeAccount">Créer un compte</button>

@code {
    private DAL.KanaContext kanaDB = new DAL.KanaContext();

    protected override async Task OnInitializedAsync()
    {
        
    }

    protected void CreateFakeAccount()
    {
        DAL.Models.Users utilisateur = new DAL.Models.Users { username = "Jojo", password = "Jojo" };
        kanaDB.Users.Add (utilisateur);
        kanaDB.SaveChanges();
    }
}
